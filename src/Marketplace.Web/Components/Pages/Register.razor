
@page "/register"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations

@inject IdentityApi IdentityApi
@inject NavigationManager Navigation

<PageTitle>Регистрация</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-center mb-4">Создание аккаунта</h2>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger">
                            @_error
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_success))
                    {
                        <div class="alert alert-success">
                            @_success
                            <div class="mt-2">
                                <a href="/login">Перейти ко входу</a>
                            </div>
                        </div>
                    }

                    <EditForm Model="_model"
                              OnValidSubmit="RegisterAsync">

                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Email</label>

                            <InputText class="form-control"
                                       type="email"
                                       @bind-Value="_model.Email"
                                       placeholder="example@mail.com" />

                            <ValidationMessage For="@(() => _model.Email)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Пароль</label>

                            <InputText class="form-control"
                                       type="password"
                                       @bind-Value="_model.Password"
                                       placeholder="Введите пароль" />

                            <ValidationMessage For="@(() => _model.Password)" />

                            <small class="text-muted">
                                Минимум 6 символов: заглавная и строчная буквы,
                                цифра и специальный символ.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Повторите пароль</label>

                            <InputText class="form-control"
                                       type="password"
                                       @bind-Value="_model.ConfirmPassword"
                                       placeholder="Повторите пароль" />

                            <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                        </div>

                        <button type="submit"
                    class="btn btn-success w-100"
                    disabled="@_loading">

                            @if (_loading)
                            {
                                <span>Регистрация...</span>
                            }
                            else
                            {
                                <span>Зарегистрироваться</span>
                            }

                        </button>

                    </EditForm>

                    <hr />

                    <div class="text-center">
                        <span>Уже есть аккаунт?</span>
                        <a href="/login">Войти</a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private RegisterModel _model = new();

    private bool _loading;
    private string? _error;
    private string? _success;

    private async Task RegisterAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var result = await IdentityApi.RegisterAsync(
                _model.Email,
                _model.Password);

            if (!result)
            {
                _error = "Не удалось зарегистрироваться. Возможно, email уже используется или пароль не соответствует требованиям.";
                return;
            }

            _success = "Регистрация успешно завершена! Теперь вы можете войти.";
            _model = new RegisterModel();
        }
        catch (HttpRequestException)
        {
            _error = "Сервис регистрации недоступен. Попробуйте позже.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Введите email")]
        [EmailAddress(ErrorMessage = "Некорректный email")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Введите пароль")]
        [MinLength(6, ErrorMessage = "Пароль должен содержать минимум 6 символов")]
        [RegularExpression(
            @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).+$",
            ErrorMessage = "Пароль должен содержать заглавную и строчную буквы, цифру и специальный символ")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Повторите пароль")]
        [Compare(nameof(Password), ErrorMessage = "Пароли не совпадают")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
