@page "/orders"
@rendermode InteractiveServer

@using System.Security.Claims
@using Marketplace.Web.Models
@using Marketplace.Web.Services

@inject OrdersApi OrdersApi
@inject DeliveriesApi DeliveriesApi
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Мои заказы</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Мои заказы</h1>

        <button class="btn btn-outline-primary"
                disabled="@_loading"
                @onclick="LoadOrdersAsync">
            Обновить
        </button>
    </div>

    @if (_loading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary"></div>
            <p>Загрузка заказов...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            @_error

            <button class="btn btn-sm btn-outline-danger ms-3"
                    @onclick="LoadOrdersAsync">
                Повторить
            </button>
        </div>
    }
    else if (_orders.Count == 0)
    {
        <div class="alert alert-info">
            У вас пока нет заказов.
        </div>

        <a href="/" class="btn btn-primary">
            Перейти в каталог
        </a>
    }
    else
    {
        @foreach (var order in _orders)
        {
            <div class="card shadow-sm mb-4" @key="order.Id">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <div>
                        <strong>Заказ №@order.Id</strong>

                        <div class="text-muted small">
                            @(order.CreatedAt.ToLocalTime()
                                .ToString("dd.MM.yyyy HH:mm"))
                        </div>
                    </div>

                    <span class="badge @GetStatusClass(order.Status)">
                        @GetStatusText(order.Status)
                    </span>

                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <strong>Адрес доставки:</strong>
                        <div>@order.DeliveryAddress</div>
                    </div>

                    <div class="border rounded p-3 mb-3">

                        <h6 class="mb-2">
                            Статус доставки
                        </h6>

                        @if (order.Status != "Completed")
                        {
                            <span class="text-muted">
                                Доставка появится после успешного завершения заказа.
                            </span>
                        }
                        else if (_deliveryErrors.Contains(order.Id))
                        {
                            <span class="text-danger">
                                Не удалось загрузить статус доставки.
                                Попробуйте обновить страницу.
                            </span>
                        }
                        else if (_deliveries.TryGetValue(
                            order.Id, out var delivery))
                        {
                            @if (delivery is null)
                            {
                                <span class="badge bg-warning text-dark">
                                    Доставка создаётся
                                </span>

                                <div class="text-muted small mt-2">
                                    Информация появится после обработки события.
                                </div>
                            }
                            else
                            {
                                <span class="badge @GetDeliveryStatusClass(delivery.Status)">
                                    @GetDeliveryStatusText(delivery.Status)
                                </span>

                                <div class="text-muted small mt-2">
                                    Обновлено:
                                    @(delivery.UpdatedAt.ToLocalTime()
                                        .ToString("dd.MM.yyyy HH:mm"))
                                </div>
                            }
                        }

                    </div>

                    <hr />

                    <h5 class="mb-3">Товары</h5>

                    @foreach (var item in order.Items)
                    {
                        <div class="d-flex justify-content-between border-bottom py-2">

                            <div>
                                <strong>@item.NameSnapshot</strong>

                                <div class="text-muted small">
                                    @item.PriceSnapshot.ToString("C")
                                    × @item.Quantity
                                </div>
                            </div>

                            <div class="fw-bold">
                                @((item.PriceSnapshot * item.Quantity)
                                    .ToString("C"))
                            </div>

                        </div>
                    }

                    <div class="d-flex justify-content-between mt-3">

                        <span class="fs-5">Итого:</span>

                        <strong class="text-primary fs-5">
                            @order.Total.ToString("C")
                        </strong>

                    </div>

                </div>

            </div>
        }
    }

</div>

@code {

    private List<Order> _orders = new();

    private readonly Dictionary<Guid, Delivery?> _deliveries = new();

    private readonly HashSet<Guid> _deliveryErrors = new();

    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        _loading = true;
        _error = null;

        _deliveries.Clear();
        _deliveryErrors.Clear();

        try
        {
            // Загружаем заказы текущего пользователя.
            _orders = await OrdersApi.GetUserOrdersAsync();

            // Информацию о доставке запрашиваем только
            // для успешно завершённых заказов.
            foreach (var order in _orders.Where(
                x => x.Status == "Completed"))
            {
                try
                {
                    _deliveries[order.Id] =
                        await DeliveriesApi.GetByOrderIdAsync(order.Id);
                }
                catch (HttpRequestException)
                {
                    // Ошибка доставки не должна скрывать историю заказов.
                    _deliveryErrors.Add(order.Id);
                }
            }
        }
        catch (HttpRequestException)
        {
            _error = "Не удалось загрузить историю заказов.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetStatusText(string status)
    {
        return status switch
        {
            "Created" => "Создан",
            "ReservingStock" => "Резервирование товара",
            "StockReserved" => "Товар зарезервирован",
            "ProcessingPayment" => "Обработка оплаты",
            "Completed" => "Завершён",
            "Cancelled" => "Отменён",
            "Failed" => "Ошибка",
            _ => status
        };
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Completed" => "bg-success",
            "Cancelled" or "Failed" => "bg-danger",
            "ProcessingPayment" or "ReservingStock" =>
                "bg-warning text-dark",
            "StockReserved" => "bg-info text-dark",
            _ => "bg-secondary"
        };
    }

    private static string GetDeliveryStatusText(string status)
    {
        return status switch
        {
            "Created" => "Ожидает обработки",
            "Preparing" => "Готовится к отправке",
            "Shipped" => "Передана в доставку",
            "Delivered" => "Доставлена",
            "Cancelled" => "Отменена",
            _ => status
        };
    }

    private static string GetDeliveryStatusClass(string status)
    {
        return status switch
        {
            "Created" => "bg-secondary",
            "Preparing" => "bg-warning text-dark",
            "Shipped" => "bg-info text-dark",
            "Delivered" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}