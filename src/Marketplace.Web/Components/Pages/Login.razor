
@page "/login"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations

@inject IdentityApi IdentityApi
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Вход</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-center mb-4">Вход в аккаунт</h2>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger">
                            @_error
                        </div>
                    }

                    <EditForm Model="_model" OnValidSubmit="LoginAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Email</label>

                            <InputText class="form-control"
                                       type="email"
                                       @bind-Value="_model.Email"
                                       placeholder="example@mail.com" />

                            <ValidationMessage For="@(() => _model.Email)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Пароль</label>

                            <InputText class="form-control"
                                       type="password"
                                       @bind-Value="_model.Password"
                                       placeholder="Введите пароль" />

                            <ValidationMessage For="@(() => _model.Password)" />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100"
                                disabled="@_loading">

                            @if (_loading)
                            {
                                <span>Вход...</span>
                            }
                            else
                            {
                                <span>Войти</span>
                            }
                        </button>

                    </EditForm>

                    <hr />

                    <div class="text-center">
                        <span>Нет аккаунта?</span>
                        <a href="/register">Зарегистрироваться</a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private LoginModel _model = new();

    private bool _loading;
    private string? _error;

    private async Task LoginAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var response = await IdentityApi.LoginAsync(
                _model.Email,
                _model.Password);

            if (response is null ||
                string.IsNullOrWhiteSpace(response.Token))
            {
                _error = "Неверный email или пароль.";
                return;
            }

            await AuthProvider.MarkUserAsAuthenticated(response.Token);

            Navigation.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            _error = "Сервис авторизации недоступен. Попробуйте позже.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Введите email")]
        [EmailAddress(ErrorMessage = "Некорректный email")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Введите пароль")]
        public string Password { get; set; } = string.Empty;
    }
}
