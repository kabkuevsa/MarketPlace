{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-min-32-chars-long-for-hmac-sha256",
    "Issuer": "Marketplace.Identity",
    "Audience": "Marketplace.Clients"
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },

      "deliveries": {
        "ClusterId": "delivery",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/deliveries/{**catch-all}"
        }
      },

      "cart": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "warehouse-stocks": {
        "ClusterId": "warehouse",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/stocks/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5131/"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5201/"
          }
        }
      },
      "delivery": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5208/"
          }
        }
      },
      "orders": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5242/"
          }
        }
      },
      "warehouse": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5130/"
          }
        }
      }
    }
  }
}