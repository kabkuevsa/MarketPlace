{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "cart": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "warehouse-stocks": {
        "ClusterId": "warehouse",
        "Match": {
          "Path": "/api/stocks/{**catch-all}"
        }
      },
      "warehouse-reservations": {
        "ClusterId": "warehouse",
        "Match": {
          "Path": "/api/reservations/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5131/"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5201/"
          }
        }
      },
      "orders": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5242/"
          }
        }
      },
      "warehouse": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5130/"
          }
        }
      },
      "payments": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5143/"
          }
        }
      }
    }
  }
}